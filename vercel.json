{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{templates,static}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ],
  "env": {
    "SMU_DB_ENGINE": "sqlite",
    "SMU_DB_PATH": "/tmp/smu_ai.db",
    "SMU_COOKIE_SECURE": "1",
    "SMU_RATE_PER_MIN": "20"
  }
}
