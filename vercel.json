{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": ["app.py", "db.py", "matcher.py", "config.py", "schema.sql", "templates/**", "static/**"]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "env": {
    "SMU_DB_ENGINE": "sqlite",
    "SMU_DB_PATH": "/tmp/smu_ai.db",
    "SMU_COOKIE_SECURE": "1",
    "SMU_RATE_PER_MIN": "20"
  }
}
