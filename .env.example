# 复制为 .env 后按需修改（本地开发用；线上在 Render 控制台配环境变量）
SMU_SECRET_KEY=请替换为随机长串（32 位以上）
SMU_HOST=0.0.0.0
SMU_PORT=8000
# 线上 HTTPS 时设为 1
SMU_COOKIE_SECURE=0

# 数据库：mysql（默认，本地开发）或 sqlite（Render 等免费环境）
SMU_DB_ENGINE=mysql
SMU_DB_PATH=./data/smu_ai.db
SMU_DB_HOST=127.0.0.1
SMU_DB_PORT=3306
SMU_DB_USER=root
SMU_DB_PASSWORD=你的数据库密码
SMU_DB_NAME=smu_ai

SMU_LLM_API_KEY=你的大模型Key
SMU_LLM_BASE_URL=https://api.deepseek.com
SMU_LLM_MODEL=deepseek-chat

SMU_ADMIN_USER=admin
SMU_ADMIN_PASSWORD=请改成一个强密码

# 每 IP 每分钟问答次数上限
SMU_RATE_PER_MIN=30
